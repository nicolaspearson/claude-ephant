{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.rulers": [
    100
  ],
  "editor.formatOnSave": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "gopls": {
    "ui.semanticTokens": true
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ab133e",
    "activityBar.background": "#ab133e",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#0a1d03",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#ab133e",
    "statusBar.background": "#7d0e2d",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#ab133e",
    "statusBarItem.remoteBackground": "#348f10",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#7d0e2d",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#7d0e2d99",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#ab133e",
    "activityBarTop.background": "#ab133e",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "statusBar.debuggingBackground": "#7d0e2d",
    "statusBar.debuggingForeground": "#e7e7e7",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBarTop.activeBorder": "#e7e7e7",
    "statusBar.inactiveBackground": "#7d0e2d"
  },
  "peacock.color": "#7d0e2d"
}